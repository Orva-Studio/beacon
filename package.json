{
  "name": "beacon",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/model",
    "packages/features",
    "packages/media",
    "packages/camtasia",
    "packages/render",
    "packages/core",
    "packages/mcp",
    "packages/ui",
    "packages/desktop"
  ],
  "scripts": {
    "build": "bun run build:tools && bun run build:engine",
    "build:tools": "bun run scripts/build-tools.ts",
    "build:engine": "cd packages/engine && env -u RUSTUP_TOOLCHAIN ~/.cargo/bin/cargo build --release",
    "test": "bun test && bun run test:ui && cd packages/engine && env -u RUSTUP_TOOLCHAIN ~/.cargo/bin/cargo test --release",
    "test:ui": "bun test ./scripts/ui-harness",
    "typecheck": "bun run --cwd packages/desktop devkit >/dev/null && tsc --noEmit -p .",
    "audit": "bun audit && cd packages/engine && env -u RUSTUP_TOOLCHAIN ~/.cargo/bin/cargo deny check",
    "dump-trec": "bun run scripts/dump-trec.ts",
    "render-cmproj": "bun run scripts/render-cmproj.ts",
    "build:mcp": "bun scripts/bundle-tools.ts --mcp dist",
    "mcp": "bun packages/mcp/src/main.ts",
    "app": "bun run build && bun run --cwd packages/desktop dev",
    "release": "bun run scripts/release.ts",
    "icon": "bun scripts/icon.ts"
  },
  "dependencies": {
    "@beacon/camtasia": "workspace:*",
    "@beacon/features": "workspace:*",
    "@beacon/media": "workspace:*",
    "@beacon/model": "workspace:*",
    "@beacon/render": "workspace:*",
    "@beacon/core": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
